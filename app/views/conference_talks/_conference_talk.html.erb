<div id="<%= dom_id conference_talk %>">
  <p>
    <strong>Title:</strong>
    <%= conference_talk.title %>
  </p>

  <p>
    <strong>Speaker:</strong>
    <%= conference_talk.speaker %>
  </p>

  <p>
    <strong>Track:</strong>
    <%= conference_talk.track %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= conference_talk.description %>
  </p>

  <p>
    <strong>Bio:</strong>
    <%= conference_talk.bio %>
  </p>

</div>
